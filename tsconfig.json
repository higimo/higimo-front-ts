{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,

		"baseUrl": "./src",
		"outDir": "./dist",
		"rootDir": "./src",

		/* Preact Config */
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"skipLibCheck": true,
		"paths": {
			"react": ["./node_modules/preact/compat/"],
			"react-dom": ["./node_modules/preact/compat/"],
		},
		"types": [
		"vitest/globals",
		"@testing-library/jest-dom"
		]
	},
	"include": ["node_modules/vite/client.d.ts", "src/**/*", "src/components/tourism/.unused"],
	"exclude": ["dist"]
}
