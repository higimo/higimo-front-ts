{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,

		// "strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,

		"incremental": true,
		// "tsBuildInfoFile": "./node_modules/.tsbuildinfo",

		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,

		/* Дополнительно */
		"removeComments": true,
		"preserveConstEnums": true,
		"sourceMap": true,

		"outDir": "./dist",
		"rootDir": "./src",

		/* Preact Config */
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"skipLibCheck": true,
		"paths": {
			"react": ["./node_modules/preact/compat/"],
			"react-dom": ["./node_modules/preact/compat/"],
			"components/*": ["./src/components/*"],
			"assets/*": ["./src/assets/*"],
			"api-types/*": ["./src/api-types/*"],
			"context/*": ["./src/context/*"],
			"hook/*": ["./src/hook/*"],
			"dic/*": ["./src/dic/*"],
			"pages/*": ["./src/pages/*"],
			"utils/*": ["./src/utils/*"],
			"vendor/*": ["./src/vendor/*"],
			"fixtures/*": ["./src/fixtures/*"],
			"toast": ["./src/toast/index.tsx"],
			"utils.type": ["./src/utils.type.ts"],
			"types": ["./src/types.ts"],
			"errors/*": ["./src/errors/*"],
			"repositories/*": ["./src/repositories/*"],
		},
		"types": [
			"vitest/globals",
			"@testing-library/jest-dom"
		]
	},
	"include": ["node_modules/vite/client.d.ts", "src/**/*", "src/components/tourism/.unused"],
	"exclude": ["dist"]
}
